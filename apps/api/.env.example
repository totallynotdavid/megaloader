# Size limits
API_MAX_SIZE_MB=4.0
API_MAX_FILES=50

# Timeouts (seconds)
API_SIZE_CHECK_TIMEOUT=5
API_DOWNLOAD_TIMEOUT=30

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
API_RATE_LIMIT_REQUESTS=10
API_RATE_LIMIT_WINDOW=60

# CORS: comma-separated origins. Credentialed cross-origin requests are only
# allowed when this is an explicit list, never with the "*" default.
API_CORS_ORIGINS=*

# Set only when running behind a proxy that sets X-Forwarded-For (Vercel does).
# Enabling it without a proxy lets clients spoof their rate-limit identity.
API_TRUST_PROXY=false

# Logging
API_LOG_LEVEL=INFO
API_LOG_FORMAT=json

# Environment
ENV=production
