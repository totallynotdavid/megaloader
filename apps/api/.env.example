# Size limits
API_MAX_SIZE_MB=4.0
API_MAX_FILES=50

# Timeouts (seconds)
API_SIZE_CHECK_TIMEOUT=5
API_DOWNLOAD_TIMEOUT=30

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
API_RATE_LIMIT_REQUESTS=10
API_RATE_LIMIT_WINDOW=60

# CORS: comma-separated origins. Credentials are allowed only for an explicit
# list, never with "*".
API_CORS_ORIGINS=*

# Read the caller IP from X-Forwarded-For. Defaults to true on Vercel, false
# elsewhere. Enable only behind a proxy that sets the header.
API_TRUST_PROXY=false

# Logging
API_LOG_LEVEL=INFO
API_LOG_FORMAT=json

# Environment
ENV=production
